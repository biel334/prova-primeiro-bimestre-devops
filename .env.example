# Credenciais do Postgres (usadas pelo container db no docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reservas

# Usadas pela API para se conectar ao banco (local: host = nome do serviço "db")
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=reservas

PORT=3000
